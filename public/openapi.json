{
  "openapi": "3.0.3",
  "info": {
    "title": "Maurício Yokoyama Issei — CV API",
    "description": "Structured data representing the professional profile and experience of Maurício Yokoyama Issei.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://mauricio.issei.com.br"
    }
  ],
  "paths": {
    "/cv.json": {
      "get": {
        "summary": "Retrieve the full CV data",
        "description": "Returns a comprehensive JSON object containing hero info, skills, experience, projects, and certifications.",
        "responses": {
          "200": {
            "description": "Successful response with CV data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CVData"
                }
              }
            }
          }
        }
      }
    },
    "/star.json": {
      "get": {
        "summary": "Retrieve STAR-formatted projects",
        "description": "Returns the STAR project case studies (Situation, Task, Action, Result) as an object keyed by year (\"2018\" … \"2025\"); each value is the list of that year's projects.",
        "responses": {
          "200": {
            "description": "Successful response with STAR data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StarData"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CVData": {
        "type": "object",
        "properties": {
          "Nome": {
            "type": "string"
          },
          "Titulo": {
            "type": "string"
          },
          "ResumoHero": {
            "type": "string"
          },
          "Habilidades": {
            "type": "object"
          },
          "Experiencia": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExperienceItem"
            }
          },
          "Projetos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectItem"
            }
          }
        }
      },
      "ExperienceItem": {
        "type": "object",
        "properties": {
          "Cargo": {
            "type": "string"
          },
          "Empresa": {
            "type": "string"
          },
          "Periodo": {
            "type": "string"
          },
          "Descricao": {
            "type": "string"
          }
        }
      },
      "ProjectItem": {
        "type": "object",
        "properties": {
          "Nome": {
            "type": "string"
          },
          "Situacao": {
            "type": "string"
          },
          "Tarefas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Acoes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Resultados": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "StarData": {
        "type": "object",
        "description": "Projects grouped by year. Keys are four-digit years.",
        "additionalProperties": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/StarProject"
          }
        }
      },
      "StarProject": {
        "type": "object",
        "required": [
          "titulo"
        ],
        "properties": {
          "titulo": {
            "type": "string"
          },
          "situacao": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "tarefas": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "tarefa": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "acoes": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "resultados": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "sub_projetos": {
            "type": "array",
            "description": "Present when one entry groups several projects (e.g. \"Sustentação AFVC\").",
            "items": {
              "$ref": "#/components/schemas/StarProject"
            }
          }
        },
        "description": "Field shapes vary between entries: situacao is a string or a list of strings, and the task list appears as tarefas or tarefa."
      }
    }
  }
}
